<Window x:Class="Egzamin01.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Egzamin01"
        mc:Ignorable="d"
        Title="Wzornik kolorów RGB. Wykonał" Height="450" Width="800" Background="#FFF8DC">
    <Grid>
        <Rectangle x:Name="mainRect" Height="100" Width="708" Margin="46,41,46,293" Fill="White"/>
        <TextBlock Margin="46,178,46,217" FontSize="18">Dobierz kolor suwakami i zapisz przyciskiem:</TextBlock>
        <Slider x:Name="sliderR" Minimum="0" Maximum="255" ValueChanged="sliderR_ValueChanged" Margin="46,222,46,182" Height="30" Value="255"/>
        <Slider x:Name="sliderG" Minimum="0" Maximum="255" ValueChanged="sliderG_ValueChanged" Margin="46,257,46,147" Height="30" Value="255"/>
        <Slider x:Name="sliderB" Minimum="0" Maximum="255" ValueChanged="sliderB_ValueChanged" Margin="46,292,46,112" Height="30" Value="255"/>
        <TextBlock Margin="30,218,754,192" FontSize="18">R</TextBlock>
        <TextBlock Margin="30,253,754,157" FontSize="18">G</TextBlock>
        <TextBlock Margin="30,288,754,122" FontSize="18">B</TextBlock>

        <TextBlock x:Name = "RValue" Margin="759,218,10,185" FontSize="18">255</TextBlock>
        <TextBlock x:Name = "GValue" Margin="759,253,10,150" FontSize="18">255</TextBlock>
        <TextBlock x:Name = "BValue" Margin="759,288,10,115" FontSize="18">255</TextBlock>

        <Button x:Name="btnSave" Content="Zapisz kolor" Margin="280,327,260,77" Height="30" Click="btnSave_Click"/>

        <Rectangle x:Name="secondRect" Margin="280,379,260,20" Fill="White"/>

        <TextBlock x:Name = "RValueRect" Margin="291,383,478,20" FontSize="18">255</TextBlock>
        <TextBlock x:Name = "GValueRect" Margin="336,383,433,29" FontSize="18" RenderTransformOrigin="0.645,1.136">255</TextBlock>
        <TextBlock x:Name = "BValueRect" Margin="381,383,388,31" FontSize="18" RenderTransformOrigin="0.645,1.136">255</TextBlock>
    </Grid>
</Window>
